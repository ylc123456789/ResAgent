# ResAgent configuration
# Copy to config.yaml and adjust paths for your environment.

agents:
  expagent_path: /home/cyl/ExpAgent
  reproagent_path: /home/cyl/reproagent
  codingagent_path: /home/cyl/CodingAgent

llm:
  api_base: https://api.deepseek.com
  api_key_env: DEEPSEEK_API_KEY
  model: deepseek-v4-pro

workspace:
  # Where runs/conversations land when --workspace is not given.
  # Resolution: --workspace CLI > $RESAGENT_WORKSPACE env > this value > ./runs
  default_runs_dir: runs
  # Example (AutoDL server): /root/autodl-tmp/resagent-workspace/runs

policy:
  max_task_retries: 2
  confirm_before_external_runs: true
  confirm_before_long_tasks: true
  shared_workspace: auto  # auto | always | never
  repro_mirror_profile: none  # none | cn | autodl
  # Pre-downloaded dataset cache for reproduction tasks (TORCH_HOME/HF_HOME etc.
  # are pointed here inside repro runs). Resolution: this value < $REPROAGENT_DATASET_CACHE.
  # Example (AutoDL server): /root/autodl-tmp/datasets
  # Side effect: the shared pip cache auto-derives to <parent>/pip-cache
  # (e.g. /root/autodl-tmp/pip-cache) unless $REPROAGENT_PIP_CACHE overrides.
  repro_dataset_cache: ""
