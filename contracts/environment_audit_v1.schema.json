{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ENVIRONMENT_AUDIT_V1",
  "title": "Environment Audit V1 — pre-reuse / certification-upgrade audit record",
  "type": "object",
  "required": [
    "schema", "audit_id", "env_id", "level", "outcome",
    "resolved_fingerprint", "audited_by", "at", "checks"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "ENVIRONMENT_AUDIT_V1"},
    "audit_id": {"type": "string", "minLength": 1},
    "env_id": {"type": "string", "pattern": "^resenv_[a-z0-9-]+_[0-9a-f]{12}$"},
    "level": {
      "type": "string",
      "enum": ["verification", "experiment"],
      "description": "experiment level may only be produced by reproagent"
    },
    "outcome": {"type": "string", "enum": ["pass", "fail"]},
    "resolved_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Inventory hash recomputed at audit time; mismatch with the manifest means drift"
    },
    "audited_by": {
      "type": "object",
      "required": ["module"],
      "additionalProperties": false,
      "properties": {
        "module": {"type": "string"},
        "run_id": {"type": "string", "default": ""},
        "task_id": {"type": "string", "default": ""}
      }
    },
    "at": {"type": "string", "format": "date-time"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "outcome"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "enum": ["hardware", "accelerator", "framework_import", "repo_probe", "policy"]
          },
          "outcome": {"type": "string", "enum": ["pass", "fail", "skip"]},
          "detail": {"type": "string", "default": ""},
          "evidence_path": {
            "type": "string",
            "default": "",
            "description": "Log artifact proving the check; required when outcome=pass for experiment level"
          }
        }
      }
    },
    "notes": {"type": "string", "default": ""}
  }
}
